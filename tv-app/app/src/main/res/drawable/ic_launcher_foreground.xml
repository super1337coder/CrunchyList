<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: a short list, top item selected.

    All marks sit inside the central 72x72 safe zone (18..90), because the outer
    ~25% is cropped by the launcher's circular mask on Google TV.

    A list of three bars was chosen over anything pictorial because it survives
    being shrunk to a ~48px disc, which a detailed illustration does not — and it
    reads as "a chosen list" rather than "a video app".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Selected item — the one accent, kept small so the icon does not read as orange -->
    <path
        android:fillColor="#F47521"
        android:pathData="M34,34 L74,34 A6,6 0 0 1 74,46 L34,46 A6,6 0 0 1 34,34 Z" />

    <!-- Remaining items, receding -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.92"
        android:pathData="M34,52 L62,52 A6,6 0 0 1 62,64 L34,64 A6,6 0 0 1 34,52 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.45"
        android:pathData="M34,70 L50,70 A6,6 0 0 1 50,82 L34,82 A6,6 0 0 1 34,70 Z" />
</vector>
