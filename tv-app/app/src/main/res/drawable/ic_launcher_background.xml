<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background.

    Deliberately NOT Crunchyroll orange. Google TV masks launcher icons into
    circles and shows CrunchyList directly alongside Crunchyroll, so an
    orange-dominant icon produced two near-identical orange discs side by side —
    exactly the two apps a kid most needs to tell apart.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#171722"
        android:pathData="M0,0h108v108h-108z" />
</vector>
