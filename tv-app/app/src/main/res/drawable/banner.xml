<?xml version="1.0" encoding="utf-8"?>
<!--
    TV launcher banner. Android TV requires android:banner on the application
    or the LEANBACK_LAUNCHER activity, else the app won't appear in the app row.
    Nominal banner size is 320x180.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <path
        android:fillColor="#F47521"
        android:pathData="M0,0h320v180h-320z" />

    <!-- Stylised 'C' -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M160,50 m-42,0 a42,42 0 1,0 42,42 a30,30 0 1,1 -30,-30 z" />
</vector>
